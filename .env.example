# Copy to .env next to docker-compose.yml and adjust as needed.

# Image tag to run: latest, or pin a release such as 1.2.3 / 1.2 / 1
KAFKADOR_VERSION=latest

# Port on the host where the UI is served. 127.0.0.1:8080 publishes it on this machine only (reach it from
# elsewhere over an SSH tunnel or a VPN), which is the safe choice if setup chose "no sign-in".
KAFKADOR_PORT=8080

# JVM options (memory, GC, ...)
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Database password for first-run setup without the setup page; see DOCKER.md (at least 8 characters).
# KAFKADOR_SETUP_PASSWORD=

# Admin password when KAFKADOR_ACCESS_MODE=database is set in docker-compose.yml; see DOCKER.md (8-128 characters).
# KAFKADOR_ADMIN_PASSWORD=
